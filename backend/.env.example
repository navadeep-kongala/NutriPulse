# Port the API server listens on
PORT=4000

# Allowed origin for CORS. Use * for local dev, or your deployed frontend URL in production.
CORS_ORIGIN=

# Optional: enables external USDA nutrition lookups for food search.
# Get a key at https://fdc.nal.usda.gov/api-key-signup.html
# Without this set, the app still works with the built-in local food database.
FOOD_DATA_API_KEY=vctTmiSEFXxCdDUKCthuaFgkNFqRTTDnnkADr78o

# Optional: alternate name supported by the app if you prefer a different env var.
USDA_API_KEY=vctTmiSEFXxCdDUKCthuaFgkNFqRTTDnnkADr78o

